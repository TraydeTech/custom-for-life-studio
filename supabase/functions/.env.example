# ============================================================
#  MERCADO PAGO (Mercado Livre) - Cartão de crédito e PIX
# ============================================================
# COMO USAR:
#   1. Copie este arquivo para: supabase/functions/.env
#      (o .env NÃO vai pro Git, já está no .gitignore)
#   2. Pegue as chaves em:
#      https://www.mercadopago.com.br/developers/panel/app
#      -> Sua aplicação -> "Credenciais de produção" (ou "de teste")
#   3. Envie para o Supabase (produção):
#      supabase secrets set --env-file supabase/functions/.env
#
# NUNCA coloque o ACCESS_TOKEN no frontend nem faça commit dele.
# ============================================================

# Ambiente: "sandbox" (teste) ou "production"
MERCADOPAGO_ENV="sandbox"

# Access Token (SECRETO - só no backend / Edge Functions)
# Teste começa com TEST-..., produção com APP_USR-...
MERCADOPAGO_ACCESS_TOKEN="APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000"

# Public Key (pode ir no frontend, usada para tokenizar o cartão)
MERCADOPAGO_PUBLIC_KEY="APP_USR-00000000-0000-0000-0000-000000000000"

# Client ID / Client Secret (opcional - OAuth / marketplace)
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""

# Assinatura secreta do webhook (Painel -> Webhooks -> "Assinatura secreta")
# Usada para validar o header x-signature das notificações
MERCADOPAGO_WEBHOOK_SECRET=""

# URL que o Mercado Pago chama quando o pagamento muda de status
MERCADOPAGO_WEBHOOK_URL="https://SEU-PROJETO.supabase.co/functions/v1/mercadopago-webhook"

# PIX: minutos até o QR Code expirar
MERCADOPAGO_PIX_EXPIRATION_MINUTES="30"

# Cartão: máximo de parcelas permitidas
MERCADOPAGO_MAX_INSTALLMENTS="12"

# Nome que aparece na fatura do cartão do cliente (até 13 caracteres)
MERCADOPAGO_STATEMENT_DESCRIPTOR="CUSTOMFORLIFE"
